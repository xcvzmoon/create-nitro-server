{
  "name": "create-nitro-server",
  "description": "Create Server using Nitro",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "nitro build",
    "dev": "nitro dev",
    "preview": "nitro preview",
    "typecheck": "tsc --noEmit --checkers 8",
    "start": "node  --env-file=.env .output/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:verbose": "vitest run --reporter=verbose",
    "prepare": "husky",
    "fmt": "oxfmt && oxfmt --check",
    "lint": "oxlint",
    "release": "node scripts/release.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "dependencies": {
    "@dymo-api/better-auth": "^1.2.33",
    "@opentelemetry/api": "^1.9.1",
    "better-auth": "^1.6.25",
    "consola": "^3.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "drizzle-query-logger": "^1.1.2",
    "effect": "^3.22.1",
    "handlebars": "^4.7.9",
    "postgres": "^3.4.9",
    "unemail": "^0.5.0",
    "uuid": "^14.0.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "drizzle-kit": "1.0.0-rc.4",
    "h3": "2.0.1-rc.22",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nitro": "latest",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "latest",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  }
}
